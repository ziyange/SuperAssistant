{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superassistant.local/schemas/sai-envelope-1.0.json",
  "title": "Super Assistant SAI 1.0 command or event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["sai_version", "message_id", "message_kind", "message_type", "created_at", "trace_id", "request_id", "idempotency_key", "workspace_id", "project_id", "task_id", "work_item_id", "attempt_id", "agent_id", "agent_version", "function_id", "function_version", "adapter_type", "adapter_version", "authorization_grant_id", "proposal_digest", "project_snapshot_version", "resource_fences", "payload_schema", "payload_digest", "payload"],
  "properties": {
    "sai_version": {"const": "1.0"},
    "message_id": {"type": "string", "minLength": 1},
    "message_kind": {"enum": ["request", "response", "command", "event", "acknowledgement"]},
    "message_type": {"enum": ["describe", "health", "start", "resume", "cancel", "status", "events", "result"]},
    "created_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 1},
    "span_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "minLength": 1},
    "function_id": {"type": "string", "minLength": 1},
    "function_version": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "adapter_type": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "authorization_grant_id": {"type": "string", "minLength": 1},
    "proposal_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "project_snapshot_version": {"type": "string", "minLength": 1},
    "resource_fences": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["resource_key", "fencing_token"], "properties": {"resource_key": {"type": "string", "minLength": 1}, "fencing_token": {"type": "integer", "minimum": 1}}}},
    "deadline_at": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 1},
    "payload_schema": {"type": "string", "minLength": 1},
    "payload_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "payload": {"type": "object"},
    "actor_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1}
  }
}
